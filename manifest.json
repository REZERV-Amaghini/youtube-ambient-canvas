{
  "manifest_version": 3,
  "name": "YouTube Ambient Canvas",
  "version": "0.2.18",
  "description": "Extend YouTube video colors across the page with radial glow, smooth scroll blending, and black-bar detection.",
  "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"},
  "permissions": ["storage"],
  "content_scripts": [
    {"matches": ["https://www.youtube.com/*"], "css": ["ambient.css"], "run_at": "document_start"},
    {"matches": ["https://www.youtube.com/*"], "js": ["settings-store.js", "black-bar-detector.js", "renderer.js", "flash-monitor.js", "worker-client.js", "ambient.js"], "run_at": "document_idle"}
  ],
  "web_accessible_resources": [
    {"resources": ["worker-host.html"], "matches": ["https://www.youtube.com/*"]}
  ],
  "browser_specific_settings": {
    "gecko": {"id": "ambient-canvas@local.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}
  }
}
